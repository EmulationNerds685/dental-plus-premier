{
  "buildCommand": "node node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@3.2.0",
      "includeFiles": "dist/server/**"
    }
  }
}
